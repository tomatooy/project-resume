{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/.env*",
        "$TURBO_ROOT$/bunfig.toml"
      ],
      "env": ["PUBLIC_*", "VITE_*", "NODE_ENV", "CLOUDFLARE_ENV"],
      "outputs": [".output/**", "dist/**", ".wrangler/deploy/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PUBLIC_*", "VITE_*", "NODE_ENV", "CLOUDFLARE_ENV"]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    }
  }
}
