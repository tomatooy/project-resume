{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vs-resume",
  "workers_dev": true,
  "main": "src/server.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "vars": {
    "PUBLIC_APP_NAME": "VS:Résumé",
    // Both tiers on the same model until the fast tier earns a cheaper one.
    // The provider switch lives in `packages/agent/src/models.ts`.
    "AI_MODEL_SMART": "deepseek-v4-flash",
    "AI_MODEL_FAST": "deepseek-v4-flash",
    "TYPESAFE_DEFAULT_MODEL": "jev-latest",
    // Exact release extension origins; .dev.vars overrides this locally.
    "EXTENSION_ORIGINS": "chrome-extension://igdgehhgebmjhimldbnpalghppmalgjh"
  },
  // DEEPSEEK_API_KEY is a secret: `wrangler secret put DEEPSEEK_API_KEY` in
  // production, `apps/web/.dev.vars` locally. Never a var.
  // TYPESAFE_API_KEY, which autofill requires for Jev, follows the same
  // secret setup. Without it, autofill's infer degrades to rules.
  // OPENAI_API_KEY is optional, for the standalone Decisions client. Use
  // .dev.vars locally and `wrangler secret put OPENAI_API_KEY` in production.
  // TAILOR_ENCRYPTION_KEY_V1: base64 encoding of 32 random bytes, also a secret.
  "workflows": [
    {
      "name": "resume-tailoring",
      "binding": "TAILOR_WORKFLOW",
      "class_name": "TailorWorkflow"
    }
  ],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
