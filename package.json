{
  "name": "project-resume",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "build:web": "bun run --no-env-file --cwd apps/web build",
    "dev": "turbo dev",
    "dev:web": "bun run --no-env-file --cwd apps/web dev",
    "dev:extension": "bun run --no-env-file --cwd apps/extension dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "check": "biome check .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "cf": "bun run --no-env-file --cwd apps/web cf",
    "deploy:check": "bun run --no-env-file --cwd apps/web deploy:check",
    "deploy:web": "bun run --no-env-file --cwd apps/web deploy",
    "db:test": "bun run --filter @workspace/supabase test:db",
    "db:check": "bun run --filter web db:check",
    "build:extension": "bun run --no-env-file --cwd apps/extension build",
    "build:extension:dev": "bun run --no-env-file --cwd apps/extension build:dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "turbo": "^2.9.18",
    "typescript": "^6"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "supabase"
  ]
}
